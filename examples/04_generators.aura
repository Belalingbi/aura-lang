// Exemple 04 : Générateurs et mot-clé yield

fn generateur_pairs(limite) {
    mut n = 0
    while n <= limite {
        yield n
        n = n + 2
    }
}

gen = generateur_pairs(8)
print("Flux de nombres pairs générés :")
print(gen.next())
print(gen.next())
print(gen.next())
print(gen.next())
print(gen.next())
print(gen.next()) // nil
